# Comma-separated browser origins allowed to call the local API.
AURA_MED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional project-local SQLite directory. Relative paths are resolved from the
# directory where the API process starts. Docker sets its own writable path.
AURA_MED_DATA_DIR=backend/.runtime

# Optional development server port. The Makefile defaults to 8000.
PORT=8000
